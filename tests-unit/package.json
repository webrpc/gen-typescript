{
  "name": "unit-tests",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.generated.json",
    "test:watch": "vitest",
    "test:update": "vitest run -u",
    "generate": "webrpc-gen -schema=service.ridl -target=../ -out=client.gen.ts",
    "generate:enum": "webrpc-gen -schema=enum.ridl -target=../ -client -out=enum-default.gen.ts && webrpc-gen -schema=enum.ridl -target=../ -client -enumStyle=union -out=enum-union.gen.ts"
  },
  "devDependencies": {
    "@tsconfig/strictest": "^2.0.7",
    "@types/node": "^24.10.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
